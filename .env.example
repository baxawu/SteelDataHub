# ============ DATABASE (Supabase Postgres) ============
# Lấy 2 chuỗi này trong Supabase Dashboard > Project Settings > Database
# DATABASE_URL: dùng connection pooling (port 6543) cho runtime app
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: dùng direct connection (port 5432) cho Prisma migration
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ============ SUPABASE (Storage cho ảnh thép) ============
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"  # chỉ dùng ở server, KHÔNG lộ ra client
SUPABASE_STORAGE_BUCKET="steel-images"

# ============ AUTH ============
# Tạo bằng lệnh: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"   # đổi thành domain thật khi deploy Vercel

# ============ APP ============
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============ SEED ADMIN (chỉ dùng lúc chạy `prisma:seed`, không commit giá trị thật) ============
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisStrongPassword@123"
